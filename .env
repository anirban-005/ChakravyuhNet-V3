# ═══════════════════════════════════════════════════════════════════════
# ChakravyuhNet — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
#
# HOW TO RUN (always use these exact commands):
#
#   BACKEND  →  cd d:\ChakravuhaNet\backend
#               .venv\Scripts\uvicorn app.main:app --host 127.0.0.1 --port 8001 --reload
#
#   FRONTEND →  cd d:\ChakravuhaNet\frontend
#               .nodeenv\Scripts\npm.cmd run dev
#
#   DASHBOARD → http://127.0.0.1:5173
#   API       → http://127.0.0.1:8001
#
# ═══════════════════════════════════════════════════════════════════════

# ── Phase 1: Ollama LLM ───────────────────────────────────────────────
# CONFIRMED WORKING on this machine (2.6 GB free RAM):
#   tinyllama:latest  → 637 MB download, ~600 MB RAM  ✅ FAST + works
#
# These models WILL FAIL (not enough RAM):
#   phi3:mini    → needs ~3 GB RAM  ❌
#   mistral      → needs ~5 GB RAM  ❌
#   llama3.1:8b  → needs ~6 GB RAM  ❌
#
# SETUP (already done — tinyllama is downloaded):
#   ollama pull tinyllama
#
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=tinyllama:latest

# ── Phase 2: Docker SDK ───────────────────────────────────────────────
# Requires Docker Desktop to be running. If not installed, system still
# works — containers just show as "Simulated" mode.
DOCKER_CONTAINER_TTL=300

# ── Phase 4: RL Policy ────────────────────────────────────────────────
RL_MODEL_PATH=backend/rl_model/chakra_rl

# ── Pro: Moving Target Defense ─────────────────────────────────────────
MTD_CYCLE_SECONDS=60
MTD_ENABLED=true

# ── Elite: Honeytoken Beacons ──────────────────────────────────────────
BEACON_CALLBACK_HOST=https://beacon.chakravyuhnet.local
HONEYTOKEN_DIR=backend/vault/honeytokens

# ── Frontend Vite config ───────────────────────────────────────────────
# Vite proxies /api and /ws to the backend automatically.
# This variable is informational only.
VITE_API_BASE_URL=http://127.0.0.1:8001
